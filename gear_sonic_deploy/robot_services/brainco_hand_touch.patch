+// MotorStates_ is reused as a portable five-finger touch container:
+// q=normal_N, dq=tangential_N, ddq=direction_deg, tau_est=proximity_raw,
+// mode=health bits, temperature=sequence, lost=full raw status.
+bool publish_touch(
+    DeviceHandler* handle, uint8_t slave_id,
+    unitree::robot::RealTimePublisher<unitree_go::msg::dds_::MotorStates_>* publisher) {
+    auto touch = modbus_get_touch_status(handle, slave_id);
+    if (!touch) return false;
+
+    if (publisher->trylock()) {
+        auto& states = publisher->msg_.states();
+        states.resize(5);
+        for (int i = 0; i < 5; ++i) {
+            const auto& item = touch->items[i];
+            states[i].q() = item.normal_force1 * 0.01f;
+            states[i].dq() = item.tangential_force1 * 0.01f;
+            states[i].ddq() = static_cast<float>(item.tangential_direction1);
+            states[i].tau_est() = static_cast<float>(item.self_proximity1);
+            states[i].mode() = static_cast<uint8_t>(item.status & 0xff);
+            states[i].temperature() = static_cast<uint8_t>(item.status >> 8);
+            states[i].lost() = item.status;
+        }
+        publisher->unlockAndPublish();
+    }
+    free_touch_finger_data(touch);
+    return true;
+}
